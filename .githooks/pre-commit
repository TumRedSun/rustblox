#!/bin/sh
# Enforced by docs/ARCHITECTURE.md. Enable once per clone with:
#   git config core.hooksPath .githooks
set -e

echo "pre-commit: cargo fmt --check"
cargo fmt --check

# No blanket `-D warnings` here: Cargo.toml's [lints] already hard-denies
# what must be hard today (dead_code, unused); unwrap/expect/panic are
# deliberately left at "warn" during the staged migration (see
# docs/ARCHITECTURE.md) and `-D warnings` would promote those pre-existing
# warnings to commit-blocking errors crate-wide, defeating that staging.
echo "pre-commit: cargo clippy --all-targets"
cargo clippy --all-targets

echo "pre-commit: ok"
